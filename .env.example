# Required for real model calls (agents, embeddings and web search).
OPENAI_API_KEY=

# Optional providers (disabled by default).
TYPESAFE_API_KEY=
DEEPSEEK_API_KEY=

# Runtime
APP_ENV=local
DEMO_MODE=false
TIMEZONE=America/Sao_Paulo
LOG_LEVEL=INFO

# Models
AGENT_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small

# Vector store: leave empty to use the embedded local store under data/runtime/qdrant.
QDRANT_URL=

# Spending guard (USD). BUDGET_LIMIT_USD caps all paid calls made by this installation (maximum 5.00; the first
# limit recorded beside the ledger can never be raised by a later value).
BUDGET_LIMIT_USD=1.00
MAX_REQUEST_COST_USD=0.05

# v0.6.0 demonstration: paid actions one demo session may start (messages, new comparison executions, Router
# comparisons and AI evaluations; anything that ends without a model call is not counted), checked by the backend, and the fixed on-demand
# evaluator (independent of the evaluated profile; its configuration is recorded with every evaluation).
# v0.8.0: the evaluator must not be the agent (AGENT_MODEL, OpenAI). The default is DeepSeek, which needs DEEPSEEK_API_KEY;
# `eval --judge` refuses an evaluator equal to the agent or without its key before any call.
DEMO_SESSION_MESSAGE_LIMIT=20
EVALUATOR_PROVIDER=deepseek
EVALUATOR_MODEL=deepseek-flash

# v0.7.0 identity (ADR 0017): the API issues RS256 access tokens (POST /v1/auth/token) and publishes its key at
# /.well-known/jwks.json. The signing key is created on first start under the runtime directory (never in Git) unless
# JWT_PRIVATE_KEY_PATH points to one. JWT_JWKS_URL switches verification to an external issuer (with its JWT_ISSUER).
# JWT_ISSUER is not set here on purpose: the API defaults to http://127.0.0.1:8000 and docker-compose sets
# http://api:8000, the issuer the ticketing service validates. Set it only for a different deployment.
JWT_PRIVATE_KEY_PATH=
JWT_JWKS_URL=
# FICTITIOUS example credentials, public in this repository: they let `docker compose up` work without editing and the
# API logs a warning while any of them is in use. Replace them before exposing the API outside this host. Stored only
# as PBKDF2-SHA256 hashes. Users: cliente1988 and cliente_demo_002 (merchants), op_ana and op_bruno (operators).
DEMO_USER_PASSWORDS=cliente1988:cliente1988-fictitious,cliente_demo_002:cliente-demo-002-fictitious,op_ana:op-ana-fictitious,op_bruno:op-bruno-fictitious
TICKETING_CLIENT_SECRET=ticketing-demo-secret-fictitious
# Users `demo` and `admin` of the web interface: empty = disabled (no public admin password).
API_DEMO_PASSWORD=
API_ADMIN_PASSWORD=
PASSWORD_HASH_ITERATIONS=600000
# Merchant token for the MCP server and local commands (`merchant-assistant auth token`); kept out of the process list.
MERCHANT_ASSISTANT_TOKEN=
# Requests per principal in a fixed 60 s window (POST /messages, POST /v1/messages); over it: 429 rate_limited.
RATE_LIMIT_PER_MINUTE=30
# v0.7.0 webhooks of the assistant (task 66): signed events to the ticketing (handoff.created, conversation.replied,
# handoff.closed) and to the merchant (conversation.replied). Empty URL = nothing is sent. These are the addresses of a
# run on this host; docker-compose sets the container ones (http://ticketing:8002/..., http://mocks:8001/...). Up to
# WEBHOOK_MAX_ATTEMPTS attempts per event, WEBHOOK_RETRY_WAITS_S seconds apart, each one recorded.
# TICKETING_WEBHOOK_SECRET (assistant -> ticketing) and ASSISTANT_WEBHOOK_SECRET (ticketing -> assistant) are shared
# with the ticketing service and defined once, in its block below. FICTITIOUS values: replace them before exposure.
TICKETING_WEBHOOK_URL=http://127.0.0.1:8002/webhooks/assistant
CONVERSATION_WEBHOOK_URL=http://127.0.0.1:8001/merchant/events
CONVERSATION_WEBHOOK_SECRET=conversation-webhook-secret-fictitious
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_RETRY_WAITS_S=1,2
WEBHOOK_TIMEOUT_S=3

# Ticketing service (demo, port 8002). Its own SQLite database; it validates operator JWTs with the assistant's JWKS
# and calls the assistant with a client_credentials token. Fictitious values: replace them before exposing the demo.
TICKETING_DB_PATH=
ASSISTANT_URL=http://127.0.0.1:8000
ASSISTANT_ISSUER=http://127.0.0.1:8000
ASSISTANT_JWKS_URL=http://127.0.0.1:8000/.well-known/jwks.json
TICKETING_WEBHOOK_SECRET=ticketing-webhook-secret-fictitious
ASSISTANT_WEBHOOK_SECRET=assistant-webhook-secret-fictitious
TICKETING_CLIENT_ID=ticketing-demo
# TICKETING_CLIENT_SECRET (client ticketing-demo) is not repeated here: it is defined once, in the v0.7.0 identity
# block of this file (version branch codex/v0.7.0-identidade-hitl), as ticketing-demo-secret-fictitious.
